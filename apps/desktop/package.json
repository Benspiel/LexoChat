{
  "name": "@lexichat/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src",
    "e2e": "vite build && playwright test",
    "tauri": "tauri",
    "build:windows": "node scripts/build-windows.mjs",
    "screenshots": "vite build && playwright test -c playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@lexichat/crypto": "workspace:*",
    "@lexichat/shared": "workspace:*",
    "@lexichat/ui": "workspace:*",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-notification": "2.5.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2"
  }
}
