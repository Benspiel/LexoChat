# LexiChat configuration – OPTIONAL. Without .env LexiChat runs on this machine
# under https://chat.localhost / https://admin.localhost with a local CA.
# For an own domain: copy to .env, fill in, then: chmod 600 .env
# Never commit .env (it is in .gitignore).

# Public host names (DNS must point to this server)
LEXICHAT_DOMAIN=chat.praxis.example
LEXICHAT_ADMIN_DOMAIN=admin.chat.praxis.example
ACME_EMAIL=it@praxis.example

# Certificates: empty = Let's Encrypt (public domain needed),
# "internal" = own local CA (practice network / Windows Docker Desktop without public domain)
LEXICHAT_TLS=

# Public URLs used by the server
LEXICHAT_APP_URL=https://chat.praxis.example
LEXICHAT_ADMIN_ORIGIN=https://admin.chat.praxis.example

# Browser origins that may call the API (CORS). The admin web app is same-origin;
# the Windows app (Tauri v2 WebView2) uses http://tauri.localhost.
LEXICHAT_ALLOWED_ORIGINS=https://admin.chat.praxis.example,http://tauri.localhost

# Optional random secret (>= 32 characters), e.g.: openssl rand -base64 48
# If empty, the server generates one on first start and stores it in the data
# volume (pb_data/.lexichat_secret). Used for keyed hashes (ip pseudonymisation,
# prelogin). Changing it is possible but makes old ip hashes incomparable.
LEXICHAT_SERVER_SECRET=

# IPs/CIDRs that may log in as PocketBase superuser (SSH tunnel -> docker bridge)
LEXICHAT_SUPERUSER_IPS=127.0.0.1/32,::1/128,172.16.0.0/12

# Optional: restrict the admin web app to the practice network / VPN (space separated)
# ADMIN_ALLOWED_IPS=192.168.10.0/24 10.8.0.0/24
