# LexiChat reverse proxy (Caddy with the rate_limit module, see Dockerfile).
#
# - TLS 1.3 only, automatic certificates (ACME), HSTS
# - the PocketBase superuser dashboard (/_/) and all superuser-only APIs are
#   NOT reachable from outside (use an SSH tunnel to 127.0.0.1:8090 instead)
# - no access log (it would contain ip addresses); errors only
{
	email {$ACME_EMAIL}
	order rate_limit before reverse_proxy
	servers {
		protocols h1 h2
	}
	log {
		level ERROR
	}
}

(tls13) {
	tls {
		protocols tls1.3
	}
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		-Server
		-X-Powered-By
	}
}

(lexichat_api) {
	@superuser path /_ /_/* /api/collections/_superusers/* /api/settings /api/settings/* /api/backups /api/backups/* /api/logs /api/logs/* /api/crons /api/crons/* /api/batch /api/collections /api/collections/import
	@collection_meta path_regexp collmeta ^/api/collections/[^/]+/?$

	handle /_* {
		respond 404
	}

	handle /api/* {
		# "route" keeps the order: block -> rate limit -> size limit -> proxy
		route {
			# superuser dashboard and superuser-only endpoints are never exposed
			respond @superuser 404
			respond @collection_meta 404

			rate_limit {
				zone login {
					match {
						path /api/collections/users/auth-with-password /api/lexichat/prelogin /api/lexichat/me/password
					}
					key {remote_host}
					events 30
					window 1m
				}
				zone api {
					key {remote_host}
					events 3000
					window 1m
				}
			}

			request_body {
				max_size 2MB
			}

			# Caddy sets X-Forwarded-For to the real peer address and ignores
			# client supplied values (no trusted_proxies configured)
			reverse_proxy server:8090
		}
	}
}

# API for the desktop clients
{$LEXICHAT_DOMAIN} {
	import tls13
	import common_headers
	header {
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options "DENY"
	}

	import lexichat_api

	handle {
		respond 404
	}
}

# Admin web app (static files + same-origin API)
{$LEXICHAT_ADMIN_DOMAIN} {
	import tls13
	import common_headers

	header {
		# 'wasm-unsafe-eval' is required for libsodium (WebAssembly) - no 'unsafe-eval', no inline scripts
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Frame-Options "DENY"
	}

	route {
		# optional: restrict the admin web app to the practice network / VPN
		@outside not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
		respond @outside 403

		import lexichat_api

		handle {
			root * /srv/admin-web
			try_files {path} /index.html
			file_server
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			header /index.html Cache-Control "no-store"
		}
	}
}

# plain http only redirects (ACME challenges are handled automatically)
