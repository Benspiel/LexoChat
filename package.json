{
  "name": "lexichat",
  "private": true,
  "description": "LexiChat – interner, Ende-zu-Ende-verschlüsselter Messenger für Arztpraxen",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:server": "cd apps/server && go test ./...",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build:admin": "pnpm --filter @lexichat/admin-web build",
    "e2e:admin": "pnpm --filter @lexichat/admin-web e2e"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
